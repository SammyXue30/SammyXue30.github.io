---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <style>
    .page-title-with-icons {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .page-title-icons {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .page-title-icon {
      height: 1em;
      width: auto;
      display: block;
      object-fit: contain;
    }
  </style>
  <header class="post-header">
    <h1 class="post-title">
      <span class="page-title-with-icons">
        <span>{{ page.title }}</span>
        {% if page.title_icons %}
          <span class="page-title-icons">
            {% for icon in page.title_icons %}
              <img
                src="{{ icon | prepend: 'assets/img/' | relative_url }}"
                alt=""
                class="page-title-icon"
                loading="eager"
              >
            {% endfor %}
          </span>
        {% endif %}
      </span>
    </h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
